---
import { icons, type IconName } from '../lib/icons';

interface Props {
	name: IconName;
	size?: number;
}

const { name, size = 18 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
	<path d={icons[name]}></path>
</svg>
