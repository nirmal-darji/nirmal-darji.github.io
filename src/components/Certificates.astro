---
import { getCollection } from 'astro:content';
import Section from './Section.astro';
import Icon from './Icon.astro';
import ExternalLink from './ExternalLink.astro';
import { formatYearMonth } from '../lib/dates';

const certificates = (await getCollection('certificates')).toSorted((a, b) =>
	b.data.issued.localeCompare(a.data.issued),
);
---

<Section id="certificates" eyebrow="Certificates" title="Credentials">
	<ul class="grid">
		{
			certificates.map(({ data: cert }) => (
				<li class="card cert reveal">
					<span class="badge" aria-hidden="true">
						<Icon name="badge" size={22} />
					</span>
					<div class="body">
						<h3>{cert.name}</h3>
						<p class="issuer">{cert.issuer}</p>
						<p class="dates muted">
							Issued {formatYearMonth(cert.issued)}
							{cert.expires && <> · Expires {formatYearMonth(cert.expires)}</>}
						</p>
						{cert.credentialId && <p class="id muted">ID: {cert.credentialId}</p>}
						{cert.verifyUrl && (
							<ExternalLink class="verify" href={cert.verifyUrl}>
								Verify credential <Icon name="external" size={14} />
								<span class="sr-only">for {cert.name}</span>
							</ExternalLink>
						)}
					</div>
				</li>
			))
		}
	</ul>
</Section>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
		gap: 1.25rem;
		list-style: none;
	}

	.cert {
		display: flex;
		gap: 1rem;
		padding: 1.4rem;
	}

	.badge {
		flex: none;
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 12px;
		background: var(--gradient);
		color: #fff;
	}

	.body {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	h3 {
		font-size: 1.05rem;
	}

	.issuer {
		font-weight: 600;
	}

	.dates,
	.id {
		font-size: 0.85rem;
	}

	.id {
		font-family: var(--font-mono);
	}

	.verify {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		margin-top: 0.6rem;
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--accent-2);
		text-decoration: none;
	}

	.verify:hover {
		text-decoration: underline;
	}
</style>
