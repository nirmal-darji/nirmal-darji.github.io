---
import Icon from './Icon.astro';

interface Props {
	icon: 'badge' | 'cap' | 'globe';
	title: string;
	subtitle?: string;
}

const { icon, title, subtitle } = Astro.props;
---

<li class="card credential reveal">
	<span class="icon" aria-hidden="true">
		<Icon name={icon} size={22} />
	</span>
	<div class="body">
		<h3>{title}</h3>
		{subtitle && <p class="subtitle">{subtitle}</p>}
		<slot />
	</div>
</li>

<style>
	.credential {
		display: flex;
		gap: 1rem;
		padding: 1.4rem;
	}

	.icon {
		flex: none;
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 12px;
		background: var(--gradient);
		color: #fff;
	}

	.body {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	h3 {
		font-size: 1.05rem;
	}

	.subtitle {
		font-weight: 600;
	}
</style>
