---
import Section from './Section.astro';
import Icon from './Icon.astro';
import { profile } from '../data/profile';
---

{
	profile.value.length > 0 && (
		<Section id="value" eyebrow="Why work with me" title="Value I bring">
			<ul class="grid">
				{profile.value.map((item) => (
					<li class="card item reveal">
						<span class="icon">
							<Icon name={item.icon} size={22} />
						</span>
						<h3>{item.title}</h3>
						<p class="muted">{item.description}</p>
						<p class="proof">{item.proof}</p>
					</li>
				))}
			</ul>
		</Section>
	)
}

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
		gap: 1rem;
		list-style: none;
	}

	.item {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1.5rem;
	}

	.icon {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 12px;
		color: #fff;
		background: var(--gradient);
		box-shadow: 0 8px 24px -10px var(--accent-1);
	}

	h3 {
		font-size: 1.1rem;
	}

	p {
		font-size: 0.95rem;
	}

	.muted {
		flex: 1;
	}

	.proof {
		padding-top: 0.75rem;
		border-top: 1px solid var(--border);
		font-size: 0.88rem;
	}
</style>
