---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import ExternalLink from './ExternalLink.astro';
import { profile } from '../data/profile';
import { withBase } from '../lib/url';
---

<section class="container hero" aria-labelledby="hero-title">
	<div class="intro">
		<div class="text">
			<h1 id="hero-title">
				Hi, I'm <span class="gradient-text">{profile.name}</span>
			</h1>
			<p class="headline">{profile.headline}</p>
			<p class="tagline muted">{profile.tagline}</p>
			<p class="location muted"><Icon name="map" size={16} /> {profile.location}</p>

			<div class="actions no-print">
				{
					profile.cv && (
						<a class="btn btn-primary" href={withBase(profile.cv)} download>
							<Icon name="download" /> Download CV
						</a>
					)
				}
				<a class="btn" href={`mailto:${profile.email}`}><Icon name="mail" /> Email me</a>
				{
					profile.socials.linkedin && (
						<ExternalLink class="btn" href={profile.socials.linkedin}>
							<Icon name="linkedin" /> LinkedIn
						</ExternalLink>
					)
				}
				{
					profile.socials.github && (
						<ExternalLink class="btn" href={profile.socials.github}>
							<Icon name="github" /> GitHub
						</ExternalLink>
					)
				}
			</div>
		</div>

		{
			profile.photo && (
				<div class="portrait">
					<Image
						src={profile.photo}
						alt={`Portrait of ${profile.name}`}
						widths={[180, 260, 520]}
						sizes="(max-width: 820px) 180px, 260px"
						loading="eager"
						fetchpriority="high"
					/>
				</div>
			)
		}
	</div>

	<ul class="stats">
		{
			profile.stats.map((stat) => (
				<li class="card stat">
					<span class="value gradient-text">{stat.value}</span>
					<span class="label muted">{stat.label}</span>
				</li>
			))
		}
	</ul>
</section>

<style>
	.hero {
		padding-block: clamp(5rem, 16vh, 10rem) 3rem;
	}

	.intro {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: center;
		gap: 3rem;
	}

	.text > *,
	.portrait,
	.stats {
		animation: rise 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
	}

	.text > :nth-child(2) {
		animation-delay: 0.05s;
	}
	.text > :nth-child(3) {
		animation-delay: 0.1s;
	}
	.text > :nth-child(4) {
		animation-delay: 0.15s;
	}
	.text > :nth-child(5),
	.portrait {
		animation-delay: 0.2s;
	}
	.stats {
		animation-delay: 0.25s;
	}

	h1 {
		font-size: clamp(2.4rem, 7vw, 4.4rem);
		font-weight: 800;
	}

	.headline {
		font-size: clamp(1.2rem, 2.6vw, 1.6rem);
		font-weight: 600;
		margin-top: 0.75rem;
	}

	.tagline {
		max-width: 46rem;
		font-size: 1.1rem;
		margin-top: 1rem;
	}

	.location {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin-top: 1rem;
		font-size: 0.95rem;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	.portrait {
		position: relative;
		width: 260px;
		aspect-ratio: 1;
		padding: 5px;
		border-radius: 50%;
		background: var(--gradient);
		box-shadow:
			0 0 80px -10px color-mix(in srgb, var(--accent-1) 55%, transparent),
			0 0 120px -30px color-mix(in srgb, var(--accent-2) 60%, transparent);
	}

	.portrait :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 25%;
		border-radius: 50%;
		border: 5px solid var(--bg);
	}

	.stats {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
		gap: 1rem;
		margin-top: 3.5rem;
		list-style: none;
	}

	.stat {
		display: flex;
		flex-direction: column;
		padding: 1.25rem 1.4rem;
	}

	.value {
		font-size: 2rem;
		font-weight: 800;
		line-height: 1.1;
	}

	.label {
		font-size: 0.9rem;
		margin-top: 0.25rem;
	}

	@media (max-width: 820px) {
		.intro {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.portrait {
			order: -1;
			width: 180px;
		}
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(18px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}
</style>
