---
import { profile } from '../data/profile';
import { withBase } from '../lib/url';
import { getPublishedProjects } from '../lib/projects';

const hasProjects = (await getPublishedProjects()).length > 0;

const links = [
	{ href: '#about', label: 'About' },
	{ href: '#experience', label: 'Experience' },
	{ href: '#companies', label: 'Companies' },
	{ href: '#recommendations', label: 'Recommendations' },
	...(hasProjects ? [{ href: '#projects', label: 'Projects' }] : []),
	{ href: '#credentials', label: 'Credentials' },
	{ href: '#contact', label: 'Contact' },
];

const initials = profile.name
	.split(' ')
	.map((part) => part[0])
	.join('');
---

<header class="nav no-print">
	<div class="container inner">
		<a class="brand" href={withBase('/')} aria-label={`${profile.name}, home`}>
			<span class="mark">{initials}</span>
			<span class="name">{profile.name}</span>
		</a>
		<nav aria-label="Sections">
			<ul>
				{
					links.map((link) => (
						<li>
							<a href={withBase(`/${link.href}`)}>{link.label}</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<style>
	.nav {
		position: sticky;
		top: 0;
		z-index: 50;
		backdrop-filter: blur(14px) saturate(140%);
		background: color-mix(in srgb, var(--bg) 70%, transparent);
		border-bottom: 1px solid var(--border);
	}

	.inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		height: 4rem;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		text-decoration: none;
		font-weight: 700;
	}

	.mark {
		display: grid;
		place-items: center;
		width: 2.1rem;
		height: 2.1rem;
		border-radius: 10px;
		background: var(--gradient);
		color: #fff;
		font-size: 0.85rem;
		letter-spacing: 0.02em;
	}

	ul {
		display: flex;
		gap: 0.25rem;
		list-style: none;
	}

	nav {
		overflow-x: auto;
		scrollbar-width: none;
	}

	nav a {
		display: block;
		padding: 0.4rem 0.75rem;
		border-radius: 999px;
		text-decoration: none;
		font-size: 0.92rem;
		color: var(--muted);
		transition:
			color 0.2s ease,
			background 0.2s ease;
	}

	nav a:hover {
		color: var(--text);
		background: var(--surface-hover);
	}

	@media (max-width: 720px) {
		.name {
			display: none;
		}

		nav {
			overflow-x: auto;
			scrollbar-width: none;
		}

		nav a {
			padding: 0.4rem 0.55rem;
			font-size: 0.85rem;
		}
	}
</style>
