---
import { getCollection } from 'astro:content';
import Section from './Section.astro';
import CredentialCard from './CredentialCard.astro';
import Icon from './Icon.astro';
import ExternalLink from './ExternalLink.astro';
import { profile } from '../data/profile';
import { formatDate } from '../lib/dates';

const certificates = (await getCollection('certificates')).toSorted((a, b) =>
	(b.data.issued ?? '').localeCompare(a.data.issued ?? ''),
);
---

<Section id="credentials" eyebrow="Credentials" title="Certifications & education">
	<ul class="grid">
		{
			certificates.map(({ data: cert }) => (
				<CredentialCard icon="badge" title={cert.name} subtitle={cert.issuer}>
					{(cert.issued || cert.expires) && (
						<p class="detail muted">
							{cert.issued && <>Issued {formatDate(cert.issued)}</>}
							{cert.issued && cert.expires && ' · '}
							{cert.expires && <>Expires {formatDate(cert.expires)}</>}
						</p>
					)}
					{cert.credentialId && <p class="detail mono muted">ID: {cert.credentialId}</p>}
					{cert.verifyUrl && (
						<ExternalLink class="verify" href={cert.verifyUrl}>
							Verify credential <Icon name="external" size={14} />
							<span class="sr-only">for {cert.name}</span>
						</ExternalLink>
					)}
				</CredentialCard>
			))
		}
		{
			profile.education.map((item) => (
				<CredentialCard icon="cap" title={item.degree} subtitle={item.institution}>
					<p class="detail muted">
						{item.period} · {item.location}
					</p>
				</CredentialCard>
			))
		}
		{
			profile.languages.length > 0 && (
				<CredentialCard icon="globe" title="Languages">
					<ul class="chips languages">
						{profile.languages.map((language) => (
							<li class="chip">{language}</li>
						))}
					</ul>
				</CredentialCard>
			)
		}
	</ul>
</Section>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
		gap: 1.25rem;
		list-style: none;
	}

	.detail {
		font-size: 0.85rem;
	}

	.mono {
		font-family: var(--font-mono);
	}

	.languages {
		margin-top: 0.5rem;
	}

	.verify {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		margin-top: 0.6rem;
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--accent-2);
		text-decoration: none;
	}

	.verify:hover {
		text-decoration: underline;
	}
</style>
