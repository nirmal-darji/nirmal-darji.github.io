---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import ProjectLinks from '../../components/ProjectLinks.astro';
import { withBase } from '../../lib/url';

export const getStaticPaths = (async () => {
	const projects = await getCollection('projects');
	return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

interface Props {
	project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
---

<BaseLayout title={data.title} description={data.summary}>
	<article class="container narrow">
		<a class="back no-print" href={withBase('/#projects')}><Icon name="arrow-left" size={16} /> All projects</a>
		<header class="header">
			<p class="meta muted">{data.role} · {data.period}</p>
			<h1 class="gradient-text">{data.title}</h1>
			<p class="summary">{data.summary}</p>
			<ul class="chips">
				{data.tech.map((item) => <li class="chip">{item}</li>)}
			</ul>
			<ProjectLinks links={data.links} />
		</header>
		{
			data.cover && (
				<Image
					class="cover"
					src={data.cover}
					alt={data.coverAlt ?? ''}
					widths={[720, 1440]}
					sizes="(max-width: 800px) 100vw, 760px"
					loading="eager"
				/>
			)
		}
		<div class="prose card">
			<Content />
		</div>
	</article>
</BaseLayout>

<style>
	.narrow {
		max-width: 800px;
		padding-block: 3rem 2rem;
	}

	.back {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--muted);
		text-decoration: none;
		font-size: 0.9rem;
	}

	.back:hover {
		color: var(--text);
	}

	.header {
		display: grid;
		gap: 1rem;
		margin: 2rem 0;
	}

	.meta {
		font-family: var(--font-mono);
		font-size: 0.85rem;
	}

	h1 {
		font-size: clamp(2rem, 5vw, 3.2rem);
		font-weight: 800;
	}

	.summary {
		font-size: 1.15rem;
	}

	.cover {
		border-radius: var(--radius);
		border: 1px solid var(--border);
		margin-bottom: 2rem;
	}

	.prose {
		padding: clamp(1.5rem, 4vw, 2.5rem);
	}

	.prose:hover {
		transform: none;
	}

	.prose :global(h2) {
		font-size: 1.35rem;
		margin: 2rem 0 0.75rem;
	}

	.prose :global(h2:first-child) {
		margin-top: 0;
	}

	.prose :global(p),
	.prose :global(ul),
	.prose :global(ol) {
		margin: 0 0 1rem;
	}

	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 1.3rem;
	}

	.prose :global(li::marker) {
		color: var(--accent-2);
	}

	.prose :global(img) {
		border-radius: 12px;
		margin: 1.5rem 0;
	}

	.prose :global(code) {
		font-family: var(--font-mono);
		font-size: 0.9em;
		padding: 0.1em 0.35em;
		border-radius: 6px;
		background: var(--surface-hover);
	}
</style>
